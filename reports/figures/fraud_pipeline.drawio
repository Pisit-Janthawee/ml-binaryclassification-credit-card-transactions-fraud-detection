<mxfile host="app.diagrams.net" pages="1"><diagram name="Credit Card Fraud: past-only card history -&gt; LightGBM -&gt; cost-based alerts" id="fraud_pipeline"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="760" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="Credit Card Fraud: past-only card history -&gt; LightGBM -&gt; cost-based alerts" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1700" height="40" as="geometry"/></mxCell><mxCell id="n1" value="Features without looking ahead" style="fontFamily=Helvetica;fontColor=#000000;rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="800" height="36" as="geometry"/></mxCell><mxCell id="n2" value="Model, threshold, explanation" style="fontFamily=Helvetica;fontColor=#000000;rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="60" width="820" height="36" as="geometry"/></mxCell><mxCell id="n3" value="" style="fontFamily=Helvetica;fontColor=#000000;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="800" height="620" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Every feature uses only the card's earlier transactions&lt;/b&gt;" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="115" width="800" height="30" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;No leakage&lt;/b&gt;&lt;br&gt;split by time: the model never trains on the future" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="780" height="70" as="geometry"/></mxCell><mxCel